# ntfy.sh topic to push alerts to (treat as a secret — anyone who knows it can
# send/read notifications on it). In GitHub Actions this comes from a repo secret.
NTFY_TOPIC=

# Bright Data API token for the Web Unlocker scraper API (free tier: 5,000
# requests/month). Create a Web Unlocker zone at brightdata.com, then use
# its API token here. Leave unset to fetch depop.com directly instead
# (works on residential IPs only; datacenter IPs are Cloudflare-blocked).
SCRAPER_API_KEY=

# Bright Data Web Unlocker zone name. Defaults to web_unlocker1 if unset.
BRIGHTDATA_ZONE=
