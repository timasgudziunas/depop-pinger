# ntfy.sh topic to push alerts to (treat as a secret — anyone who knows it can
# send/read notifications on it). In GitHub Actions this comes from a repo secret.
NTFY_TOPIC=

# ScrapeBadger API key (sb_live_... prefix) for their dedicated Depop API.
# Pay-as-you-go $0.15/1,000 credits; search + detail calls cost 10 credits
# each. Free tier rate limit: 5 requests/minute. Leave unset to fetch
# depop.com directly instead (works on residential IPs only; datacenter
# IPs are Cloudflare-blocked).
SCRAPER_API_KEY=
